<h3>5.2 JavaScript API Calls and State Management</h3>
<p>The application uses <b>React Context API</b> for global state management across 4 providers:</p>
<code>// App.jsx — Provider hierarchy
&lt;ThemeProvider&gt;
  &lt;AuthProvider&gt;
    &lt;ToastProvider&gt;
      &lt;ModalProvider&gt;
        &lt;RouterProvider router={router} /&gt;
      &lt;/ModalProvider&gt;
    &lt;/ToastProvider&gt;
  &lt;/AuthProvider&gt;
&lt;/ThemeProvider&gt;</code>

<p><b>Auth Context</b> — Listens for Supabase auth state changes and provides user data:</p>
<code>useEffect(() => {
    supabase.auth.getSession().then(({ data: { session } }) => {
        if (session?.user) loadProfile(session.user.id);
        else setLoading(false);
    });
    const { data: { subscription } } = supabase.auth.onAuthStateChange(
        (event, session) => {
            if (event === 'SIGNED_IN' || event === 'TOKEN_REFRESHED')
                setTimeout(() => loadProfile(session.user.id), 0);
            else if (event === 'SIGNED_OUT') setUser(null);
        }
    );
    return () => subscription.unsubscribe();
}, [loadProfile]);</code>

<h3>5.3 Real-time Data Binding — useRealtime Hook</h3>
<code>export function useRealtime(channelName, { event='*', table, filter }, callback) {
    const callbackRef = useRef(callback);
    callbackRef.current = callback;
    useEffect(() => {
        const channel = supabase
            .channel(channelName)
            .on('postgres_changes',
                { event, schema: 'public', table, filter },
                (payload) => callbackRef.current(payload))
            .subscribe();
        return () => supabase.removeChannel(channel);
    }, [channelName, event, table, filter]);
}

// Usage in Navbar — live notifications
useRealtime(
    `notifications:${user?.id}`,
    { table: 'notifications', filter: `user_id=eq.${user?.id}` },
    loadNotifications
);</code>

<h3>5.4 Responsive Design — Mobile UX</h3>
<p>The application uses Tailwind CSS responsive breakpoints:</p>
<ul>
<li><b>Mobile (&lt;768px):</b> Hamburger menu via MobileMenu.jsx, single-column layouts, full-width cards.</li>
<li><b>Tablet (768px–1024px):</b> Two-column feed grid, condensed navigation.</li>
<li><b>Desktop (1024px+):</b> Full navigation bar, side-by-side layouts on request detail, multi-column grids.</li>
</ul>
<p>Key responsive patterns:</p>
<code>/* Hidden on mobile, visible on desktop */
className="hidden md:flex items-center gap-1"

/* Mobile-only hamburger */
className="md:hidden flex items-center gap-1"

/* Responsive grid */
className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"</code>

<h3>5.5 Form Validation</h3>
<code>export function validateRequest(data) {
    const errors = {};
    if (!data.item?.trim()) errors.item = 'What item needs to be delivered?';
    else if (data.item.length > 50) errors.item = 'Item name is too long.';
    if (!data.pickup?.trim()) errors.pickup = 'Where should the item be picked up?';
    if (!data.dropoff?.trim()) errors.dropoff = 'Where should it be dropped off?';
    const reward = parseFloat(data.reward);
    if (isNaN(reward)) errors.reward = 'Reward must be a number.';
    else if (reward < 5) errors.reward = 'Minimum reward is 5 BDT.';
    else if (reward > 10000) errors.reward = 'Maximum reward is 10,000 BDT.';
    return { isValid: Object.keys(errors).length === 0, errors };
}</code>

<h3>5.6 Dynamic Content Loading and User Feedback</h3>
<p>Loading states use <b>Skeleton components</b> that match the final layout shape:</p>
<code>// Skeleton shimmer for cards while data loads
export function SkeletonCard() {
    return (
        &lt;Card className="p-5"&gt;
            &lt;Skeleton className="w-9 h-9 rounded-full" /&gt;
            &lt;Skeleton className="h-6 w-3/4 mb-2" /&gt;
            &lt;Skeleton className="h-4 w-full mb-4" /&gt;
            &lt;Skeleton className="h-20 w-full rounded-xl" /&gt;
        &lt;/Card&gt;
    );
}</code>
<p>User feedback is provided through <b>Toast notifications</b> (auto-dismiss after 3.5s) and <b>Confirmation modals</b> for destructive actions.</p>

