<h2>4. Backend Implementation</h2>

<h3>4.1 Server-Side Logic Overview</h3>
<p>CUETConnect uses <b>Supabase</b> as a Backend-as-a-Service. Instead of a traditional Express/Django server, all server-side logic is implemented through:</p>
<ul>
<li><b>PostgreSQL tables</b> with Row Level Security (RLS) policies for access control.</li>
<li><b>Database triggers</b> for automatic actions (e.g., creating a profile on sign-up).</li>
<li><b>RPC functions</b> (plpgsql) for atomic operations that bypass RLS using SECURITY DEFINER.</li>
<li><b>Supabase Auth</b> for Google OAuth with automatic JWT management.</li>
<li><b>Supabase Realtime</b> for WebSocket-powered live updates.</li>
</ul>

<h3>4.2 Authentication — Google OAuth Flow</h3>
<code>// Supabase client configuration
const supabase = createClient(supabaseUrl, supabaseAnonKey, {
    auth: {
        persistSession: true,
        storageKey: 'cuet-connect-auth',
        autoRefreshToken: true,
        detectSessionInUrl: true,
    },
});

// Google OAuth trigger
const signInWithGoogle = async () => {
    await supabase.auth.signInWithOAuth({
        provider: 'google',
        options: { redirectTo: window.location.origin + '/feed' },
    });
};</code>

<h3>4.3 Database Trigger — Auto-Create Profile</h3>
<code>CREATE OR REPLACE FUNCTION public.handle_new_user()
RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER AS $
BEGIN
  INSERT INTO public.profiles (id, name, email)
  VALUES (
    NEW.id,
    COALESCE(NEW.raw_user_meta_data ->> 'full_name',
             NEW.raw_user_meta_data ->> 'name', ''),
    COALESCE(NEW.email, '')
  );
  RETURN NEW;
END;
$;

CREATE TRIGGER on_auth_user_created
  AFTER INSERT ON auth.users
  FOR EACH ROW EXECUTE FUNCTION public.handle_new_user();</code>

<h3>4.4 Schema Creation — Main Tables</h3>
<code>CREATE TABLE profiles (
    id UUID PRIMARY KEY REFERENCES auth.users(id),
    name TEXT, email TEXT, student_id TEXT,
    department TEXT, batch TEXT, hall TEXT, phone TEXT,
    rating NUMERIC DEFAULT 5.0, total_ratings INT DEFAULT 0,
    deliveries_completed INT DEFAULT 0, requests_posted INT DEFAULT 0,
    total_earnings INT DEFAULT 0, badges TEXT[] DEFAULT '{}',
    bookmarked_requests TEXT[] DEFAULT '{}',
    created_at TIMESTAMPTZ DEFAULT now()
);

CREATE TABLE requests (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    item TEXT NOT NULL, pickup TEXT NOT NULL, dropoff TEXT NOT NULL,
    reward NUMERIC DEFAULT 0, urgency TEXT DEFAULT 'Medium',
    details TEXT, status TEXT DEFAULT 'Open',
    requester_id UUID REFERENCES profiles(id),
    requester_name TEXT, accepted_by_id UUID REFERENCES profiles(id),
    accepted_by_name TEXT, accepted_at TIMESTAMPTZ,
    in_progress_at TIMESTAMPTZ, completed_at TIMESTAMPTZ,
    payment_method TEXT, payment_status TEXT DEFAULT 'Unpaid',
    rating INT, reported_by TEXT[] DEFAULT '{}',
    created_at TIMESTAMPTZ DEFAULT now(),
    updated_at TIMESTAMPTZ DEFAULT now()
);

CREATE TABLE messages (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    request_id UUID REFERENCES requests(id),
    sender_id UUID REFERENCES profiles(id),
    sender_name TEXT, text TEXT NOT NULL,
    created_at TIMESTAMPTZ DEFAULT now()
);

CREATE TABLE notifications (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID REFERENCES profiles(id),
    text TEXT NOT NULL, read BOOLEAN DEFAULT false,
    request_id UUID REFERENCES requests(id),
    type TEXT DEFAULT 'info',
    created_at TIMESTAMPTZ DEFAULT now()
);</code>

<h3>4.5 RPC Functions — Atomic Business Logic</h3>
<code>-- Increment deliverer stats on completion
CREATE OR REPLACE FUNCTION increment_deliverer_stats(
    deliverer_id UUID, earning_amount NUMERIC
) RETURNS VOID AS $
BEGIN
  UPDATE profiles
  SET total_earnings = COALESCE(total_earnings,0) + earning_amount,
      deliveries_completed = COALESCE(deliveries_completed,0) + 1
  WHERE id = deliverer_id;
END;
$ LANGUAGE plpgsql SECURITY DEFINER;

-- Recalculate running average rating
CREATE OR REPLACE FUNCTION update_deliverer_rating(
    deliverer_id UUID, new_rating NUMERIC
) RETURNS VOID AS $
BEGIN
  UPDATE profiles
  SET rating = (COALESCE(rating,5)*COALESCE(total_ratings,0) + new_rating)
               / (COALESCE(total_ratings,0) + 1),
      total_ratings = COALESCE(total_ratings,0) + 1
  WHERE id = deliverer_id;
END;
$ LANGUAGE plpgsql SECURITY DEFINER;</code>

<h3>4.6 Row Level Security (RLS) Policies</h3>
<code>-- Profiles: users can read all, update only own
ALTER TABLE profiles ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Anyone can view profiles" ON profiles FOR SELECT USING (true);
CREATE POLICY "Users can update own profile" ON profiles
  FOR UPDATE USING (auth.uid() = id);

-- Requests: authenticated users can read all, insert/update own
ALTER TABLE requests ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Authenticated can view requests" ON requests
  FOR SELECT USING (auth.role() = 'authenticated');
CREATE POLICY "Authenticated can insert requests" ON requests
  FOR INSERT WITH CHECK (auth.role() = 'authenticated');
CREATE POLICY "Authenticated can update requests" ON requests
  FOR UPDATE USING (auth.role() = 'authenticated');</code>

<h3>4.7 Server-Side Validation and Error Management</h3>
<p>The frontend database abstraction layer (<code>lib/db/</code>) handles all error cases:</p>
<code>// Standardized error response wrapper
export const dbResponse = (data = null, error = null) => ({ data, error });

// Supabase error code formatter
export function formatError(err) {
    if (!err) return null;
    if (err.code) {
        switch (err.code) {
            case '23505': return 'This record already exists.';
            case '42P01': return 'Database configuration error.';
            case 'PGRST116': return 'Requested record not found.';
            default: break;
        }
    }
    return err.message || 'An unexpected error occurred.';
}</code>

<h3>4.8 Database Abstraction Layer — CRUD Operations</h3>
<code>// requestsDB.create() — Insert new delivery request
async create(data) {
    const { data: row, error } = await supabase
        .from('requests')
        .insert({
            item: data.item, pickup: data.pickup,
            dropoff: data.dropoff, reward: data.reward,
            urgency: data.urgency, details: data.details,
            requester_id: data.requesterId,
            requester_name: data.requesterName,
            status: 'Open',
        })
        .select().single();
    if (error) return null;
    // Increment requester's post count
    await supabase.rpc('increment_requests_posted',
        { user_id: data.requesterId });
    return mapRequest(row);
}

// requestsDB.accept() — Accept delivery with validation
async accept(requestId, userId, userName) {
    const existing = await requestsDB.getById(requestId);
    if (!existing || existing.status !== 'Open') return null;
    if (existing.requesterId === userId) return null; // Can't self-accept
    const { data: row, error } = await supabase
        .from('requests')
        .update({
            status: 'Accepted', accepted_by_id: userId,
            accepted_by_name: userName,
            accepted_at: new Date().toISOString(),
        })
        .eq('id', requestId).eq('status', 'Open')
        .select().single();
    if (error) return null;
    await addNotification(existing.requesterId,
        `${userName} accepted your request for "${existing.item}"`,
        requestId, 'success');
    return mapRequest(row);
}</code>

